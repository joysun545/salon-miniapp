page { background: #f8f4ee; color: #26372d; font-size: 30rpx; }
.screen { padding: 38rpx 30rpx 56rpx; }
.heading { font-size: 52rpx; font-weight: 650; margin: 0 0 12rpx; }
.subtitle, .muted { color: #55675a; margin-bottom: 18rpx; }
.section { font-size: 35rpx; font-weight: 650; margin: 32rpx 0 16rpx; }
.panel { background: white; border-radius: 22rpx; padding: 25rpx; margin-bottom: 18rpx; }
.panel-title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.price { color: #315846; font-weight: 700; margin: 14rpx 0; }
.error { color: #9d2d26; margin: 16rpx 0; }
button.action { background: #315846; color: white; margin-top: 16rpx; font-size: 29rpx; }
button.action[disabled] { background: #e4e9e2; color: #515c51; }
button.secondary { background: #e9eee7; color: #315846; margin-top: 14rpx; font-size: 28rpx; }
.field { padding: 18rpx; margin: 12rpx 0; border-radius: 12rpx; background: #f0f2ee; }
.links { display: flex; gap: 14rpx; flex-wrap: wrap; margin: 24rpx 0; }
.links navigator { background: #e9eee7; border-radius: 16rpx; padding: 16rpx; }
