page { background: #f8f4ee; color: #252b24; }
.page { padding: 44rpx 36rpx; }
.title { font-size: 56rpx; font-weight: 600; margin-bottom: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.field { padding: 24rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: #f3f3ed; }
button.primary { background: #315846; color: #fff; }
button.primary[disabled] { background: #e4e9e2; color: #515c51; }
button.secondary { background: #f3f3ed; color: #315846; margin-top: 16rpx; }
.status { color: #315846; margin-top: 16rpx; }
.error { color: #9d2d26; margin: 24rpx 0; }
.hint { color: #515c51; margin-bottom: 16rpx; }
