<view class="screen">
  <view class="heading">店员工作台</view>
  <input class="field" password placeholder="店员联调令牌" bindinput="inputToken" />
  <button class="secondary" bindtap="refresh">查看或刷新任务</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{verified}}">
    <view class="section">预约任务</view>
    <view wx:if="{{!bookings.length}}" class="muted">暂无预约任务。</view>
    <view wx:for="{{bookings}}" wx:key="id" class="panel">
      <view class="panel-title">{{item.name}}</view>
      <view>{{item.label}} · {{item.statusLabel}}</view>
      <block wx:if="{{item.status === 'pending'}}">
        <button class="action" data-id="{{item.id}}" data-action="accept" bindtap="act" disabled="{{busy}}">确认接单</button>
        <button class="secondary" data-id="{{item.id}}" data-action="decline" bindtap="act" disabled="{{busy}}">无法承接</button>
      </block>
      <button wx:if="{{item.status === 'accepted'}}" class="action" data-id="{{item.id}}" data-action="finish" bindtap="act" disabled="{{busy}}">确认已提供服务</button>
    </view>
    <view class="section">门店排班</view>
    <view wx:for="{{schedules}}" wx:key="id" class="panel">{{item.label}}</view>
  </block>
</view>
